# Which AI stack to use: "gemini" (default when GEMINI_API_KEY is set) or "openai".
AI_PROVIDER=gemini

# --- Gemini (Google AI Studio key) ---
GEMINI_API_KEY=
# speech-to-speech interviewer
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Aoede
# essay strategist (3.5-flash drafts in ~20s; 3.8-flash takes 3–4 min, so it is only the fallback)
GEMINI_STRATEGY_MODEL=gemini-3.5-flash
# minimal/low/medium/high; empty = model default
GEMINI_THINKING_LEVEL=

# --- OpenAI (alternative) ---
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-1.5
REALTIME_VOICE=marin
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
LLM_MODEL=gpt-5.4
LLM_REASONING_EFFORT=medium

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*

# --- Login ---
# Public URL of the app (used in password-reset emails)
FRONTEND_URL=http://localhost:3000
# Google sign-in: OAuth "Web application" client ID; add http://localhost:3000 as an Authorized JavaScript origin
GOOGLE_CLIENT_ID=
# Email for login codes and password resets. Leave EMAIL_HOST empty to print emails to the backend log.
# Gmail example: EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_USER=you@gmail.com, EMAIL_HOST_PASSWORD=<16-char app password>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
# Set true when serving over HTTPS
SESSION_COOKIE_SECURE=false

# --- MongoDB Atlas: ALL data + logs (required) ---
# Atlas → Connect → Drivers → copy the mongodb+srv://… string with your DB user's password.
# Keep the quotes (the string contains '&').
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"
MONGODB_DB=ivy
MONGODB_LOG_LEVEL=INFO
MONGODB_LOG_TTL_DAYS=30
# Also keep one denormalised document per brainstorm in `brainstorms` (analytics/export)
MONGODB_MIRROR_DOCUMENTS=false

# Dev only: skip the LLM and return a canned essay structure
STRATEGIST_MOCK=false
